{
  "name": "BATCH: a fan inside ONE op still selects its first sibling, even next to other ops on the same parent",
  "ops": [
    {
      "op": "add_nodes",
      "panel": "p",
      "nodes": [
        {"id": "a1", "role": "assistant", "content": "one", "parent": "u1"},
        {"id": "a2", "role": "assistant", "content": "two", "parent": "u1"}
      ],
      "select": true
    },
    {"op": "select", "panel": "p", "parent_key": "u1", "child_id": "a2"}
  ],
  "trees_before": {
    "p": {
      "nodes": {"u1": {"id": "u1", "role": "user", "content": "hi", "parent": null, "children": []}},
      "rootChildren": ["u1"],
      "selected": {"__root__": "u1"}
    }
  },
  "trees_after": {
    "p": {
      "nodes": {
        "u1": {"id": "u1", "role": "user", "content": "hi", "parent": null, "children": ["a1", "a2"]},
        "a1": {"id": "a1", "role": "assistant", "content": "one", "parent": "u1", "children": []},
        "a2": {"id": "a2", "role": "assistant", "content": "two", "parent": "u1", "children": []}
      },
      "rootChildren": ["u1"],
      "selected": {"__root__": "u1", "u1": "a2"}
    }
  }
}
